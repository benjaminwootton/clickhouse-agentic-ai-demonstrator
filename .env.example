# ClickHouse — required. The app refuses to start if this is not set.
# Defaults below target a ClickHouse running locally over plain HTTP.
CLICKHOUSE_URL=http://host.docker.internal:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Running the app outside Docker (npm start)? Use localhost instead:
# CLICKHOUSE_URL=http://localhost:8123
#
# Inside a container, "localhost" is the container itself, so a ClickHouse on
# your own machine is reached via host.docker.internal. Docker Desktop provides
# that name; on Linux docker-compose.yml maps it to the bridge gateway
# (usually 172.17.0.1) via extra_hosts.
#
# If that connection times out, two host-side settings are the usual cause:
#   1. A distro-packaged ClickHouse listens on loopback only. Uncomment
#      <listen_host>::</listen_host> in /etc/clickhouse-server/config.xml and
#      restart it. `ss -tlnp | grep 8123` should then show *:8123.
#   2. A host firewall is dropping bridge traffic. For ufw:
#      sudo ufw allow proto tcp from 172.16.0.0/12 to 172.17.0.1 port 8123
#
# ClickHouse Cloud or any other remote instance:
# CLICKHOUSE_URL=https://your-instance.clickhouse.cloud:8443
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=your-password

# Model providers — any OpenAI-compatible endpoint. Configure up to five.
# These are copied into the local database on first boot; after that they are
# managed from Site Administration → Providers. An API key is optional, so
# unauthenticated local endpoints work.
PROVIDER_1_NAME=
PROVIDER_1_API_KEY=
PROVIDER_1_BASE_URL=
PROVIDER_1_MODEL=

# Example — a local Ollama, reached the same way as ClickHouse above:
# PROVIDER_2_NAME=Local
# PROVIDER_2_API_KEY=
# PROVIDER_2_BASE_URL=http://host.docker.internal:11434/v1
# PROVIDER_2_MODEL=llama3.3

PROVIDER_2_NAME=
PROVIDER_2_API_KEY=
PROVIDER_2_BASE_URL=
PROVIDER_2_MODEL=

PROVIDER_3_NAME=
PROVIDER_3_API_KEY=
PROVIDER_3_BASE_URL=
PROVIDER_3_MODEL=

PROVIDER_4_NAME=
PROVIDER_4_API_KEY=
PROVIDER_4_BASE_URL=
PROVIDER_4_MODEL=

PROVIDER_5_NAME=
PROVIDER_5_API_KEY=
PROVIDER_5_BASE_URL=
PROVIDER_5_MODEL=

# Optional: LLM observability. Leave LANGFUSE_HOST empty for Langfuse Cloud,
# or point it at your own self-hosted instance. Tracing stays off until both
# keys are present.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
